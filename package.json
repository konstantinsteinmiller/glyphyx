{
  "name": "glyphyx",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "art:prompts": "node --import ./tools/ts-resolve.mjs tools/art-prompts.mjs",
    "art:export": "node tools/export-sheets.mjs",
    "art:status": "node --import ./tools/ts-resolve.mjs tools/art-status.mjs",
    "art:splash-tile": "node --import ./tools/ts-resolve.mjs tools/splash-tile.mjs",
    "art:slice": "node tools/slice-sheets.mjs",
    "art:measure": "python tools/measure-art.py",
    "art:compress": "node scripts/compress-images.mjs public/images --backup-dir public-backup",
    "art:desk": "node tools/art-desk/server.mjs",
    "compress-folder": "node scripts/compress-images.mjs",
    "compress-bench": "node scripts/image-compress-bench.mjs",
    "compress-restore": "node scripts/restore-originals.mjs",
    "compress-folder-with-backup": "node scripts/compress-images.mjs public/images --max-effort --backup-dir public-backup",
    "compress-promotion-with-backup": "node scripts/compress-images.mjs src/assets/promotion --max-effort --backup-dir src/assets/promotion-backup",
    "dev-playgama": "vite --mode playgama",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:crazy-web": "vite build --mode crazy-web --base=./ ",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && wavedash build push",
    "build:itch": "vite build --mode itch --base=./ && cd dist && tar -a -cf ../glyphyx-itch.zip * && cd .. && move glyphyx-itch.zip dist\\",
    "build:glitch": "vite build --mode glitch --base=./ && cd dist && tar -a -cf ../glyphyx-glitch.zip * && cd .. && move glyphyx-glitch.zip dist\\",
    "build:game-distribution": "vite build --mode game-distribution --base=./",
    "build:playgama": "vite build --mode playgama --base=./ && cd dist && tar -a -cf ../glyphyx-playgama.zip * && cd .. && move glyphyx-playgama.zip dist\\",
    "build:gamepix": "vite build --mode gamepix --base=./ && cd dist && tar -a -cf ../glyphyx-gamepix.zip * && cd .. && move glyphyx-gamepix.zip dist\\",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && cd dist && tar -a -cf ../glyphyx-gamemonetize.zip * && cd .. && move glyphyx-gamemonetize.zip dist\\",
    "build:yandex": "vite build --mode yandex --base=./ && cd dist && tar -a -cf ../glyphyx-yandex.zip * && cd .. && move glyphyx-yandex.zip dist\\",
    "build:poki": "vite build --mode poki --base=./ && cd dist && tar -a -cf ../glyphyx-poki.zip * && cd .. && move glyphyx-poki.zip dist\\",
    "deploy:poki": "node tools/poki-deploy/deploy.mjs",
    "build-github-main": "vite build --base=/glyphyx/ --outDir=dist",
    "build-github-develop": "vite build --base=/glyphyx/develop/ --outDir=dist/develop",
    "deploy": "vite build && surge dist/ --domain glyphyx.surge.sh",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "leaderboard:seed": "node scripts/leaderboard-seed.mjs",
    "leaderboard:snapshot": "node scripts/leaderboard-snapshot.mjs",
    "perf:ab": "node scripts/perf-ab.mjs",
    "qa:portal": "node scripts/portal-qa.mjs",
    "preview:video": "node tools/preview-video/record.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@vueuse/core": "^14.2.1",
    "@wvdsh/sdk-js": "^0.0.38",
    "lodash.clonedeep": "^4.5.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@napi-rs/image": "^1.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "sharp": "^0.35.4",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
