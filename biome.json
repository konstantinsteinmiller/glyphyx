{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf",
		"attributePosition": "multiline"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "es5",
			"arrowParentheses": "asNeeded"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useTemplate": "error",
				"useBlockStatements": "error",
				"noUselessElse": "error"
			},
			"suspicious": {
				"noDebugger": "warn",
				"noConsole": {
					"level": "warn",
					"options": {
						"allow": [
							"warn",
							"error",
							"info",
							"debug",
							"time",
							"timeEnd",
							"group",
							"groupEnd",
							"table",
							"trace",
							"assert"
						]
					}
				}
			},
			"nursery": {
				"useVueHyphenatedAttributes": "error",
				"useVueConsistentVBindStyle": "error",
				"useVueConsistentVOnStyle": "off",
				"useVueValidVHtml": "off",
				"useVueMultiWordComponentNames": "off"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noVueReservedProps": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"options": {
								"strictCase": false
							}
						}
					},
					"nursery": {
						"useVueMultiWordComponentNames": "off"
					},
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
