coverage
*.local
*.env
.env
.env.*
# Non-secret build state checked in so multiple dev machines stay in
# sync (Android versionCode counter — Play Console rejects re-uploads
# of the same code, so the latest value MUST be committed).
!.env.tauri.remote

# Editor directories and files
.vscode/settings.json
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo

.eslintcache

# Cypress
/cypress/videos/
/cypress/screenshots/

# Vitest
__screenshots__/

# Vite
*.timestamp-*-*.mjs
/src/assets/inspiration/Campaign map.png
/src/assets/inspiration/Deck building.png
/src/assets/inspiration/Devil Card game field.vue.png
/src/assets/inspiration/Game over.png
/src/assets/inspiration/good duel intro.png
/src/assets/inspiration/main menu.png
/src/assets/inspiration/Rules page.png
/src/assets/inspiration/Take Card.vue.png
/src/assets/inspiration/Turn selection.png
/output_previews/*

# iOS xcframeworks downloaded by tauri-plugin-levelplay/build.rs
/src-tauri/plugins/tauri-plugin-levelplay/ios/Frameworks/
/src/assets/art/

# Per-checkout browser profiles for the MCP servers (see .mcp.json). Repo-
# relative so concurrent sessions — the main checkout and each agent worktree —
# never contend for one profile directory.
.mcp-browser-profiles
# TinyPNG download receipts (which files that tool processed). They must never
# sit under public/ — Vite copies public/ verbatim, so they shipped 1.25 MB
# into every portal zip. They live in art-sheets/tinypng-receipts/ now.
*tinified.zip

# Pristine copies kept by scripts/compress-images.mjs so --force can re-run
# without stacking generation loss. Outside public/ for the same reason.
/public-backup/

# Paintings the Art Desk (tools/art-desk) replaced with a newer return. Kept
# on disk so a re-roll never loses a good generation; not worth a commit.
/art-sheets/painted/replaced/

# Playwright e2e output
/test-results
/playwright-report

# Portal preview videos rendered by tools/preview-video (pnpm preview:video).
# Regenerable from the scenarios, and a lossless 10 s 720p clip is tens of MB.
/preview-videos/

# FX bench renders (tools/fx-bench/shoot.mjs) — contact sheets, WAVs, stats
/fx-bench-out/

# Poki release-audit screenshots (scripts/poki-release-audit.mjs) — one per
# graded viewport, rewritten on every run.
/scripts/audit/

# Poki QA report (tools/poki-deploy) — regenerated on every `pnpm deploy:poki`.
/poki-qa-report.json
